{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build with cl.exe",
      "type": "shell",
      "command": "cl.exe",
      "args": [
        "/Feubasicd", "/Zi", "/EHsc", "cli-ubasic.c","ubasic.c","tokenizer.c"
      ],
        "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
