10 REM 2D NUMERIC ARRAY WITH READ/DATA
20 DIM m(3,3)
30 READ m(0,0), m(0,1), m(0,2)
40 READ m(1,0), m(1,1), m(1,2)
50 READ m(2,0), m(2,1), m(2,2)
60 PRINT "Matrix:"
70 PRINT m(0,0); " "; m(0,1); " "; m(0,2)
80 PRINT m(1,0); " "; m(1,1); " "; m(1,2)
90 PRINT m(2,0); " "; m(2,1); " "; m(2,2)
100 DATA 1, 2, 3
110 DATA 4, 5, 6
120 DATA 7, 8, 9
130 END
